{
  "name": "library_frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run prepare:barcode && nuxt build",
    "build:production": "npm run verify:production-env && npm run verify:security && npm run verify:compatibility && npm run build",
    "dev": "npm run prepare:barcode && nuxt dev",
    "generate": "npm run prepare:barcode && nuxt generate",
    "preview": "nuxt preview",
    "prepare:barcode": "node scripts/copy-zxing-wasm.mjs",
    "verify:production-env": "node scripts/verify-production-env.mjs",
    "postinstall": "nuxt prepare && npm run prepare:barcode",
    "typecheck": "nuxt typecheck",
    "analyze": "nuxt build --analyze",
    "verify:security": "node scripts/verify-production-security.mjs",
    "test": "vitest --run --project unit --project nuxt",
    "test:watch": "vitest --watch --project unit --project nuxt",
    "test:unit": "vitest --run --project unit",
    "test:nuxt": "vitest --run --project nuxt",
    "test:e2e:chromium": "vitest --run --project e2e-chromium",
    "test:e2e:firefox": "vitest --run --project e2e-firefox",
    "test:e2e:webkit": "vitest --run --project e2e-webkit",
    "test:e2e": "npm run test:e2e:chromium && npm run test:e2e:firefox && npm run test:e2e:webkit",
    "test:live": "vitest --run --project live",
    "test:regression": "npm run test:unit && npm run test:nuxt && npm run test:e2e:chromium",
    "test:full": "npm run test:unit && npm run test:nuxt && npm run test:e2e",
    "test:browsers:install": "playwright-core install chromium firefox webkit",
    "verify:test-dependencies": "node scripts/verify-test-dependencies.mjs",
    "setup:acceptance:authenticated": "node scripts/setup-library-acceptance-auth.mjs --target=localhost",
    "setup:acceptance:authenticated:staging": "node scripts/setup-library-acceptance-auth.mjs --target=staging",
    "verify:acceptance:setup-helper": "node --test test/node/setup-library-acceptance-auth.test.mjs",
    "test:acceptance": "npm run test:acceptance:local",
    "test:acceptance:authenticated": "npm run test:acceptance:authenticated:local",
    "test:acceptance:authenticated:local": "node scripts/run-library-acceptance.mjs --target=localhost --browser=chromium --scope=authenticated-readonly",
    "test:acceptance:authenticated:cross-browser": "node scripts/run-library-acceptance.mjs --target=localhost --browser=all --scope=authenticated-readonly",
    "test:acceptance:local": "node scripts/run-library-acceptance.mjs --target=localhost --browser=chromium --scope=readonly",
    "test:acceptance:local:write": "node scripts/run-library-acceptance.mjs --target=localhost --browser=chromium --scope=write",
    "test:acceptance:cross-browser": "node scripts/run-library-acceptance.mjs --target=localhost --browser=all --scope=readonly",
    "test:acceptance:release:local": "node scripts/run-library-acceptance.mjs --target=localhost --browser=all --scope=release",
    "test:acceptance:staging": "node scripts/run-library-acceptance.mjs --target=staging --browser=all --scope=release",
    "verify:acceptance:coverage": "node scripts/verify-acceptance-test-coverage.mjs",
    "verify:release-source": "node scripts/verify-release-source.mjs",
    "verify:accessibility": "vitest --run --project unit test/unit/uswitch-accessibility-contract.test.ts test/unit/interactive-accessibility-source-scan.test.ts",
    "verify:compatibility": "node scripts/verify-production-compatibility.mjs",
    "verify:deployment:local": "node scripts/verify-deployment-compatibility.mjs --target=localhost",
    "verify:deployment:staging": "node scripts/verify-deployment-compatibility.mjs --target=staging",
    "verify:deployment:production": "node scripts/verify-deployment-compatibility.mjs --target=production",
    "release:verify": "node scripts/run-release-verification.mjs",
    "release:phase36": "npm run verify:production-env && npm run verify:security && npm run verify:compatibility && npm run verify:accessibility && npm run verify:release-source && npm run typecheck && npm run build",
    "test:acceptance:staging:chromium": "node scripts/run-library-acceptance.mjs --target=staging --browser=chromium --scope=release",
    "test:acceptance:production": "node scripts/run-library-acceptance.mjs --target=production --browser=all --scope=release",
    "test:acceptance:production:chromium": "node scripts/run-library-acceptance.mjs --target=production --browser=chromium --scope=release",
    "verify:compatibility:contract": "node --test test/node/phase35-36-release-compatibility.test.mjs",
    "phase35:cross-browser": "npm run phase35:preview:prepare && node scripts/run-production-preview-check.mjs --check=acceptance --browser=all",
    "phase36:local": "npm run verify:security && npm run verify:compatibility && npm run verify:accessibility && npm run verify:release-source && npm run verify:acceptance:coverage && npm run typecheck && npm run phase35:preview:prepare && npm run verify:deployment:preview",
    "phase36:staging": "npm run verify:deployment:staging && npm run test:acceptance:staging",
    "phase36:production": "npm run verify:deployment:production && npm run test:acceptance:production",
    "setup:acceptance:authenticated:production": "node scripts/setup-library-acceptance-auth.mjs --target=production",
    "phase35:chromium": "node scripts/run-production-preview-check.mjs --check=acceptance --browser=chromium",
    "phase35:firefox": "node scripts/run-production-preview-check.mjs --check=acceptance --browser=firefox",
    "phase35:webkit": "node scripts/run-production-preview-check.mjs --check=acceptance --browser=webkit",
    "test:order": "node scripts/print-test-command-order.mjs",
    "test:browsers:install:webkit-wsl": "playwright-core install webkit-wsl",
    "phase35:preview:prepare": "node scripts/prepare-production-preview.mjs",
    "phase35:webkit:wsl": "node scripts/run-production-preview-check.mjs --check=acceptance --browser=webkit --webkit-channel=webkit-wsl",
    "phase35:cross-browser:wsl-webkit": "npm run phase35:preview:prepare && node scripts/run-production-preview-check.mjs --check=acceptance --browser=all --webkit-channel=webkit-wsl",
    "verify:deployment:preview": "node scripts/run-production-preview-check.mjs --check=deployment",
    "test:acceptance:staging:wsl-webkit": "node scripts/run-library-acceptance.mjs --target=staging --browser=all --scope=release --webkit-channel=webkit-wsl",
    "test:acceptance:production:wsl-webkit": "node scripts/run-library-acceptance.mjs --target=production --browser=all --scope=release --webkit-channel=webkit-wsl",
    "phase36:staging:wsl-webkit": "npm run verify:deployment:staging && npm run test:acceptance:staging:wsl-webkit",
    "phase36:production:wsl-webkit": "npm run verify:deployment:production && npm run test:acceptance:production:wsl-webkit",
    "phase35:webkit:docker": "node scripts/run-playwright-docker-webkit.mjs",
    "phase35:cross-browser:docker-webkit": "npm run phase35:preview:prepare && npm run phase35:chromium && npm run phase35:firefox && npm run phase35:webkit:docker"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.2",
    "@nuxt/ui": "^4.9.0",
    "docx": "^9.7.1",
    "exceljs": "^3.4.0",
    "html-to-image": "^1.11.13",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "nuxt": "^4.1.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "vue-qrcode-reader": "5.7.3",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@nuxt/test-utils": "^4.1.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.5.0 <25",
    "npm": ">=10.0.0"
  }
}
