# Copy to .env.e2e.local for localhost testing.
# Do not commit real credentials.
E2E_FRONTEND_URL=http://localhost:3000
E2E_BACKEND_URL=http://localhost:1337

# Authenticated read-only gate: all four dedicated role accounts are required.
# These accounts should be test-only/local or staging accounts; do not use production credentials.
# Role accounts reserved for automated testing.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_LIBRARIAN_USERNAME=
E2E_LIBRARIAN_PASSWORD=
E2E_STUDENT_USERNAME=
E2E_STUDENT_PASSWORD=
E2E_FACULTY_USERNAME=
E2E_FACULTY_PASSWORD=

# These four read-only route fixtures can be discovered automatically after the four role credentials are filled.
# Run: npm run setup:acceptance:authenticated
# They may also be supplied manually when needed.
E2E_BOOK_DOCUMENT_ID=
E2E_BOOK_ID=
E2E_ADMIN_USER_ID=
E2E_ADMIN_ROLE_ID=

# Transaction fixtures used only when E2E_ALLOW_WRITES=true.
# Use a dedicated test Student and one Available test copy.
E2E_STUDENT_BARCODE=
E2E_AVAILABLE_BOOK_BARCODE=
E2E_RESERVATION_BOOK_QUERY=

# Keep writes disabled by default. The dedicated write command enables them only for that run.
E2E_ALLOW_WRITES=false

# Required only when running: npm run test:acceptance:local:write
# Confirms the three transaction fixtures are dedicated local test data.
E2E_LOCAL_WRITE_CONFIRMATION=

# Remote/staging/production write acceptance is disabled by design.
# These compatibility flags remain false; only the localhost write command can mutate data.
E2E_ALLOW_REMOTE_WRITES=false
E2E_REMOTE_WRITE_CONFIRMATION=

# Optional runtime behavior.
E2E_TIMEOUT_MS=30000
E2E_HEADED=false
