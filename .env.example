# Development (same computer)
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Production recommendation: reverse-proxy /api and /uploads through the same
# HTTPS origin as Nuxt, then set this to an empty value or omit it at runtime.
# NUXT_PUBLIC_STRAPI_URL=
#
# If the API is on a separate origin, it MUST be HTTPS in production and
# MUST be the origin only (no /api suffix/path):
# NUXT_PUBLIC_STRAPI_URL=https://api.example.edu

# HSTS is enabled in production. Only enable includeSubDomains after confirming
# every affected subdomain supports HTTPS. HSTS_PRELOAD requires it as well.
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# IMPORTANT:
# Local npm install/dev may use HTTP localhost safely:
#   NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
# The Nuxt config intentionally does NOT fail during `npm install`/`nuxt prepare`.
# Before a real deployment, run:
#   npm run verify:production-env
# or use the strict build wrapper:
#   npm run build:production
