# Production/live acceptance is READ-ONLY by design.
# Copy to .env.e2e.production and provide dedicated non-privileged verification accounts.
# Never enable write acceptance against live production data.
E2E_FRONTEND_URL=https://library.example.edu
E2E_BACKEND_URL=https://library-api.example.edu

E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_LIBRARIAN_USERNAME=
E2E_LIBRARIAN_PASSWORD=
E2E_STUDENT_USERNAME=
E2E_STUDENT_PASSWORD=
E2E_FACULTY_USERNAME=
E2E_FACULTY_PASSWORD=

# Read-only dynamic route fixtures.
E2E_BOOK_DOCUMENT_ID=
E2E_BOOK_ID=
E2E_ADMIN_USER_ID=
E2E_ADMIN_ROLE_ID=

E2E_ALLOW_WRITES=false
E2E_ALLOW_REMOTE_WRITES=false
E2E_TIMEOUT_MS=45000
E2E_HEADED=false
