# Normal isolated Nuxt tests do not need a real Strapi server.
# Keep this empty to exercise same-origin URL behavior in the test-built Nuxt app.
NUXT_PUBLIC_STRAPI_URL=

# Live integration suite is opt-in because it uses real test accounts/database state.
RUN_LIVE_TESTS=false
TEST_STRAPI_URL=http://localhost:1337
TEST_FRONTEND_ORIGIN=http://localhost:3000
TEST_FRONTEND_URL=http://localhost:3000

# Use dedicated non-production test accounts. Never commit real passwords.
TEST_ADMIN_IDENTIFIER=
TEST_ADMIN_PASSWORD=
TEST_LIBRARIAN_IDENTIFIER=
TEST_LIBRARIAN_PASSWORD=
TEST_STUDENT_IDENTIFIER=
TEST_STUDENT_PASSWORD=
TEST_FACULTY_IDENTIFIER=
TEST_FACULTY_PASSWORD=
